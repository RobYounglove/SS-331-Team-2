# Doxyfile for Array Doxygen Assignment
# Documentation prepared by Samyog Ucchai

PROJECT_NAME           = "Array Class Documentation"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "Doxygen documentation for the Array class"
OUTPUT_DIRECTORY       = docs

# Input files
INPUT                  = array.h \
                         array.cpp \
                         arraydriver.cpp
FILE_PATTERNS          = *.h \
                         *.cpp
RECURSIVE              = NO
INPUT_ENCODING         = UTF-8

# General documentation settings
FULL_PATH_NAMES        = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = NO

# Warnings
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES

# Source code links/listings
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES
SHOW_INCLUDE_FILES     = YES
SHOW_USED_FILES        = YES

# HTML output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE            = YES

# LaTeX / PDF output
GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex
COMPACT_LATEX          = NO
PAPER_TYPE             = letter
PDF_HYPERLINKS         = YES
USE_PDFLATEX           = YES
LATEX_BATCHMODE        = NO

# Disable outputs not needed for this assignment
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

# Graphviz / UML / call graph settings
HAVE_DOT               = YES
CLASS_DIAGRAMS         = YES
CLASS_GRAPH             = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 50
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = png
INTERACTIVE_SVG        = NO
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 0

# Preprocessor
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SEARCH_INCLUDES        = YES
HAVE_DOT = NO
INPUT = ZipCodeBuffer.h ZipCodeBuffer.cpp main.cpp
FILE_PATTERNS = *.h *.cpp
EXTRACT_ALL = YES
GENERATE_LATEX = YES
HAVE_DOT = NO
PROJECT_NAME = "Zip Code Group Project 1.0"
PROJECT_BRIEF = "CSV buffer and geographic extrema application"
INPUT = ZipCodeBuffer.h ZipCodeBuffer.cpp main.cpp
EXCLUDE =
