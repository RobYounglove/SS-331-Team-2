
# ============================================================
# ZIP CODE GROUP PROJECT 2.0
# CSCI 331 - Doxygen Configuration
# ============================================================

# ------------------------------------------------------------
# Project Information
# ------------------------------------------------------------

DOXYFILE_ENCODING      = UTF-8

PROJECT_NAME           = "Zip Code Group Project"
PROJECT_NUMBER         = "2.0"
PROJECT_BRIEF          = "CSCI 331 ZIP Code Group Project 2.0"

OUTPUT_DIRECTORY       = docs

CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

# ------------------------------------------------------------
# Input Files
# ------------------------------------------------------------

INPUT                  = main.cpp \
                         ZipCodeBuffer.h \
                         ZipCodeBuffer.cpp \
                         Index.h \
                         Index.cpp \
                         Search.h \
                         Search.cpp \
                         LengthIndicatedBuffer.h \
                         LengthIndicatedBuffer.cpp \
                         CSVConversion.cpp

INPUT_ENCODING         = UTF-8

FILE_PATTERNS          = *.h \
                         *.cpp

RECURSIVE              = NO

EXCLUDE_SYMLINKS       = YES

# ------------------------------------------------------------
# Source Code Documentation
# ------------------------------------------------------------

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .

# ------------------------------------------------------------
# Source Code Browser
# ------------------------------------------------------------

SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# ------------------------------------------------------------
# Documentation Formatting
# ------------------------------------------------------------

BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES

ALWAYS_DETAILED_SEC    = YES
INLINE_INHERITED_MEMB  = NO

MULTILINE_CPP_IS_BRIEF = NO

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# ------------------------------------------------------------
# Warning Settings
# ------------------------------------------------------------

QUIET                  = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES

WARN_FORMAT            = "$file:$line: $text"

# ------------------------------------------------------------
# HTML Documentation
# ------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html

HTML_COLORSTYLE        = AUTO_LIGHT
HTML_DYNAMIC_MENUS     = YES

GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES

DISABLE_INDEX          = NO

# ------------------------------------------------------------
# LaTeX / PDF Documentation
# ------------------------------------------------------------

GENERATE_LATEX         = YES

LATEX_OUTPUT           = latex
LATEX_CMD_NAME         = latex
MAKEINDEX_CMD_NAME     = makeindex

COMPACT_LATEX          = NO
PAPER_TYPE             = letter

PDF_HYPERLINKS         = YES
USE_PDFLATEX           = YES

LATEX_BATCHMODE        = NO
LATEX_HIDE_INDICES     = NO

# ------------------------------------------------------------
# File and Class Documentation
# ------------------------------------------------------------

SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
SHOW_INCLUDE_FILES     = YES

SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO

# ------------------------------------------------------------
# Diagrams and Graphs
# ------------------------------------------------------------

HAVE_DOT               = YES
DOT_NUM_THREADS        = 0

CLASS_DIAGRAMS         = YES

CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES

INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES

CALL_GRAPH             = NO
CALLER_GRAPH           = NO

DIRECTORY_GRAPH        = YES

DOT_IMAGE_FORMAT       = png

# ------------------------------------------------------------
# Preprocessing
# ------------------------------------------------------------

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO

SEARCH_INCLUDES        = YES

# ------------------------------------------------------------
# Other Output Formats
# ------------------------------------------------------------

GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
GENERATE_AUTOGEN_DEF   = NO

# ============================================================
# END OF DOXYFILE
# ============================================================
